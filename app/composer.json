{
    "name": "nolanknollwood/translatethis",
    "description": "A Docker demo app for learning PHP, Nginx, Docker, and MySQL.",
    "minimum-stability": "dev",
    "license": "MIT",
    "authors": [
        {
            "name": "Nolan Knollwood",
            "email": "nolan@knollwood.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "ext-pdo": "*",
        "ext-mysqli": "*",
        "symfony/cache": "^6.1",
        "predis/predis": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "run-phpunit": "vendor/bin/phpunit"
    }
}